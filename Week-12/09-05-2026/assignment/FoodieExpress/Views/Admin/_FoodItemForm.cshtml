@model FoodItem

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-grid">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="PreparationMinutes">Prep minutes</label>
        <input asp-for="PreparationMinutes" class="form-control" />
        <span asp-validation-for="PreparationMinutes" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Rating"></label>
        <input asp-for="Rating" class="form-control" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>
    <div>
        <label>Upload image</label>
        <input name="image" type="file" accept="image/*" class="form-control" />
    </div>
</div>
<label asp-for="ImageUrl">Image URL</label>
<input asp-for="ImageUrl" class="form-control" />
<span asp-validation-for="ImageUrl" class="text-danger"></span>

<label asp-for="Description"></label>
<textarea asp-for="Description" class="form-control" rows="4"></textarea>
<span asp-validation-for="Description" class="text-danger"></span>

<label class="check-row">
    <input asp-for="IsAvailable" />
    <span>Available for customers</span>
</label>
