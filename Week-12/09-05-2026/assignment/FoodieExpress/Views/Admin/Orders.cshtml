@model List<Order>
@{
    ViewData["Title"] = "Manage orders";
}

<section class="container py-5">
    <div class="section-title">
        <div>
            <p class="eyebrow">Admin</p>
            <h1>Order management</h1>
        </div>
    </div>
    <div class="table-shell">
        <table class="table align-middle">
            <thead><tr><th>Order</th><th>Customer</th><th>Address</th><th>Status</th><th>Total</th><th>Update</th></tr></thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><a asp-controller="Orders" asp-action="Invoice" asp-route-id="@order.Id">#@order.Id</a></td>
                    <td>@order.CustomerName<br /><span class="text-muted">@order.PhoneNumber</span></td>
                    <td>@order.DeliveryAddress</td>
                    <td><span class="status-pill">@order.Status</span></td>
                    <td>₹@order.Total.ToString("0")</td>
                    <td>
                        <form asp-action="UpdateOrderStatus" method="post" class="status-form">
                            <input type="hidden" name="id" value="@order.Id" />
                            <select name="status" class="form-select">
                                @foreach (var status in Enum.GetValues<OrderStatus>())
                                {
                                    <option value="@status" selected="@(status == order.Status)">@status</option>
                                }
                            </select>
                            <button class="secondary-btn" type="submit">Update</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
