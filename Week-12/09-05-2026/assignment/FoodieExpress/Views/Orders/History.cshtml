@model List<Order>
@{
    ViewData["Title"] = "Order history";
}

<section class="container py-5">
    <div class="section-title">
        <div>
            <p class="eyebrow">Orders</p>
            <h1>Order history</h1>
        </div>
    </div>
    <div class="table-shell">
        <table class="table align-middle">
            <thead><tr><th>Order</th><th>Date</th><th>Items</th><th>Status</th><th>Total</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.OrderedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                    <td>@order.Items.Count</td>
                    <td><span class="status-pill">@order.Status</span></td>
                    <td>₹@order.Total.ToString("0.00")</td>
                    <td><a asp-action="Invoice" asp-route-id="@order.Id">Invoice</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
